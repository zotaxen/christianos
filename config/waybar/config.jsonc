{
    "layer": "top",
    "position": "top",
    "height": 36,
    "margin-top": 2,
    "margin-left": 10,
    "margin-right": 15,
    "spacing": 6,

    "modules-left": ["custom/start", "hyprland/workspaces", "hyprland/window", "memory", "cpu"],
    "modules-center": ["hyprland/language", "clock"],
    "modules-right": ["network", "custom/bluetooth", "pulseaudio", "battery", "custom/einstellungen", "custom/power"],

    "custom/start": {
        "format": "\uf303",
        "tooltip": false,
	"on-click": "~/.config/rofi/ordner.sh"},

    "hyprland/workspaces": { "format": "{id}" },

    "hyprland/window": {
        "format": "{class}",
        "max-length": 20
    },

    "clock": {
        "format": "\uf017  {:%H:%M}",
        "format-alt": "\uf073  {:%A, %d.%m.%Y}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },

    "hyprland/language": {
    	"format": "\uf11c  {short}",
    	"on-click": "hyprctl switchxkblayout all next"
    },
    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-muted": "\uf026  stumm",
        "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
        "on-click": "pkill -x pavucontrol || pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
    },

    "custom/bluetooth": {
        "exec": "bluetoothctl show | grep -q 'Powered: yes' && echo '\uf293 an' || echo '\uf293 aus'",
        "interval": 5,
        "on-click": "pkill -x blueman-manager || blueman-manager",
        "on-click-right": "bluetoothctl show | grep -q 'Powered: yes' && bluetoothctl power off || bluetoothctl power on",
        "tooltip": false
    },

    "network": {
        "format-ethernet": "\uf0e8  LAN",
        "format-wifi": "\uf1eb  {essid}",
        "format-disconnected": "offline",
	"on-click": "~/.config/waybar/scripts/netzwerk-fenster.sh"
    },

    "cpu": { "format": "\uf2db  {usage}%" },
    "memory": { "format": "\uf538  {}%" },

    "custom/einstellungen": {
        "format": "\uf013",
        "on-click": "~/.config/waybar/scripts/einstellungen-menue.sh",
        "tooltip": false
    },

    "custom/power": {
        "format": "\uf011",
        "on-click": "~/.config/waybar/scripts/power-menue.sh",
        "tooltip": false
    }
}

"battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}  {capacity}%",
    "format-charging": "\uf0e7  {capacity}%",
    "format-plugged": "\uf1e6  {capacity}%",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "tooltip-format": "{timeTo}"
},
